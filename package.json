{
 "name": "lyricadder",
 "productName": "lyricadder",
 "version": "1.2.2.1",
 "description": "Simple tool to add lyrics to .chart files",
 "main": "main.js",
 "scripts": {
  "start": "electron .",
  "test": "echo \"Error: no test specified\" && exit 1",
  "package-mac": "electron-packager . --overwrite --platform=darwin --arch=x64 --icon=assets/icons/mac/icon.icns --prune=true --out=release-builds",
  "package-win": "electron-packager . lyricadder --overwrite --asar --platform=win32 --arch=x64 --prune=true --out=release-builds --win32metadata.CompanyName=CE --win32metadata.FileDescription=CE --win32metadata.ProductName=\"LyricAdder\"",
  "package-linux": "electron-packager . electron-tutorial-app --overwrite --asar=true --platform=linux --arch=x64 --icon=assets/icons/png/1024x1024.png --prune=true --out=release-builds"
 },
 "repository": {
  "type": "git",
  "url": "git+https://github.com/DarkAngel2096/lyricAdder.git"
 },
 "author": "DarkAngel2096",
 "license": "ISC",
 "bugs": {
  "url": "https://github.com/DarkAngel2096/lyricAdder/issues"
 },
 "homepage": "https://github.com/DarkAngel2096/lyricAdder#readme",
 "dependencies": {
  "jquery": "^4.1.0"
 },
 "devDependencies": {
  "@electron/packager": "^20.3.0",
  "electron": "^45.4.1"
 }
}
